rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return request.auth.token.email;
    }

    match /users/{email} {
      allow read, delete: if signedIn() && email == userEmail();

      allow create: if signedIn()
        && email == userEmail()
        && request.resource.data.email == userEmail()
        && request.resource.data.typeAccount == 'gratis';

      allow update: if signedIn()
        && email == userEmail()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'name',
          'avatarUrl',
          'authProvider',
          'updated_at',
        ]);
    }

    match /purchase_validations/{validationId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == userEmail()
        && request.resource.data.status == 'pending'
        && request.resource.data.product_id is string
        && request.resource.data.target_plan in ['basico', 'plus', 'premium'];

      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /activity_invites/{inviteId} {
      allow create: if signedIn()
        && request.resource.data.owner_email == userEmail()
        && request.resource.data.participant_email is string;

      allow read: if signedIn()
        && (resource.data.owner_email == userEmail()
          || resource.data.participant_email == userEmail());

      allow update: if signedIn()
        && resource.data.participant_email == userEmail()
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['status', 'updated_at', 'responded_at']);

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
