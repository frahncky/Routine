# Copie para .env (ambiente local/emulador) ou configure como variável de
# ambiente no console do Firebase (Functions > Configuração) antes do deploy.
# Não commitar o .env real.

# Package name do app no Google Play Console (deve bater com
# android/app/google-services.json -> package_name).
GOOGLE_PLAY_PACKAGE_NAME=com.routine.app

# O segredo compartilhado da Apple (APPLE_SHARED_SECRET) NÃO vai aqui — é um
# valor sensível e deve ser configurado como Cloud Functions secret:
#   firebase functions:secrets:set APPLE_SHARED_SECRET
